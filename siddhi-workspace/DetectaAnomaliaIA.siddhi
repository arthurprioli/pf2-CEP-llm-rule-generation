@App:name('DetectaAnomaliaIA') @source(type='inMemory', topic='EventosSimulador') define stream FluxoEntrada (usuario string, texto string, acao string); @sink(type='log', prefix='[ALERTA IA]') define stream AlertasStream (usuario string, tipo_alerta string, quantidade long); from FluxoEntrada[acao == 'brute_force']#window.timeBatch(10 sec) select usuario, 'BruteForce' as tipo_alerta, count() as quantidade group by usuario having quantidade > 5 insert into AlertasStream;